{
	"name": "zusia",
	"private": true,
	"version": "1.8.0",
	"description": "Zusia, a study buddy for Zotero: chat with Claude Code, Codex, Antigravity, or any ACP agent about the paper you are reading.",
	"type": "module",
	"scripts": {
		"vendor": "node scripts/vendor.mjs",
		"test:api:zotero": "node test/native-api.mjs",
		"test:api:live": "node test/live-api.mjs",
		"test": "node --test test/*.test.mjs",
		"build": "bash build.sh",
		"shots": "bash test/screenshots.sh",
		"test:zotero": "bash test/integration/run.sh",
		"test:zotero:linux": "bash test/integration/linux/run.sh",
		"test:zotero:windows": "bash test/integration/windows/run.sh",
		"videos": "bash test/videos/zotero/record.sh"
	},
	"devDependencies": {
		"esbuild": "0.28.2",
		"eventsource-parser": "4.1.3",
		"jsdom": "^26.1.0"
	}
}
